# Shared
DOCKER_SETUP_DIR=/home/bk/docker/setup
DOCKER_DATA_DIR=/home/bk/docker/data
DOCKER_SOCKET_PATH=/var/run/docker.sock
RESTART_POLICY=unless-stopped
TZ=Europe/Warsaw
PUID=1000
PGID=1000
APP_NETWORK=app-network

# Nginx Proxy Manager
NGINX_PM_VERSION=latest
NGINX_HTTP_PORT=80
NGINX_ADMIN_PORT=81
NGINX_HTTPS_PORT=443

# Samba
SAMBA_VERSION=latest
SAMBA_USER=USER_X
SAMBA_PASSWORD=USER_X_PASSWORD
SAMBA_USER_ADMIN=USER_X_ADMIN
SAMBA_PASSWORD_ADMIN=USER_X_ADMIN_PASSWORD
SAMBA_ADMIN_UID=1001
SAMBA_ADMIN_GID=1001

# FileBrowser
FILEBROWSER_VERSION=stable
FILEBROWSER_HTTP_PORT=7000
FILEBROWSER_ADMIN_PASSWORD=USER_X_FB_ADMIN_PASS

# PostgreSQL
POSTGRES_VERSION=latest
POSTGRES_DB=USER_X_POSTGRES_DB
POSTGRES_USER=USER_X_POSTGRES_USER
POSTGRES_PASSWORD=USER_X_POSTGRES_PASSWORD
POSTGRES_PORT=5432


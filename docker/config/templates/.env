# Shared - you should not change these values
# They will be automatically filled by scripts during setup
# If you don't use scripts fill these values manually with 
# correct values for your setup
DOCKER_SETUP_DIR=/home/USER_X/docker/setup
DOCKER_DATA_DIR=/home/USER_X/docker/data
DOCKER_SOCKET_PATH=/var/run/docker.sock
PUID=1000
PGID=1000

# Shared - change according to your setup
RESTART_POLICY=unless-stopped
TZ=Europe/Warsaw
APP_NETWORK=app-network